[ext_resource type="StyleBox" path="res://gui/popup.tres" id="9"]

[node name="Root" type="Node2D"]
script = ExtResource("4")

[node name="GUI" parent="." instance=ExtResource("1")]
offset_left = 10.0
offset_top = 705.0
offset_right = 1270.0
