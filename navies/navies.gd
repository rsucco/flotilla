static func ensign(navy: String) -> Texture2D:
	return load("res://navies/" + navy + ".svg")


# A name from `navy`'s list for a ship of type `ship_name`, with its prefix,
# that isn't one of `taken`; "" if there's none
static func ship_title(navy: String, ship_name: String, taken: Array[String]) -> String:
	var details: Dictionary = ALL[navy]
	var names: Array = details.ships.get(ship_name, []).filter(
		func(n: String) -> bool: return not taken.has(_prefixed(details, n))
	)
	return "" if names.is_empty() else _prefixed(details, names.pick_random())


static func _prefixed(details: Dictionary, ship: String) -> String:
	var prefix: String = details.get("other_prefixes", {}).get(ship, details.prefix)
	return ship if prefix.is_empty() else prefix + " " + ship
