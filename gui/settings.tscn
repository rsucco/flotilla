[gd_scene format=3]

[ext_resource type="Script" path="res://gui/settings.gd" id="1"]
[ext_resource type="StyleBox" path="res://gui/popup.tres" id="2"]
[ext_resource type="AudioStream" path="res://audio/battleship.wav" id="3"]

[node name="Settings" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("2")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Settings"
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 12
columns = 2

[node name="MasterLabel" type="Label" parent="Panel/Margin/VBox/Grid"]
layout_mode = 2
text = "Master volume"

[node name="Master" type="HSlider" parent="Panel/Margin/VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="MusicLabel" type="Label" parent="Panel/Margin/VBox/Grid"]
layout_mode = 2
text = "Music"

[node name="Music" type="HSlider" parent="Panel/Margin/VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="EffectsLabel" type="Label" parent="Panel/Margin/VBox/Grid"]
layout_mode = 2
text = "Sound effects"

[node name="Effects" type="HSlider" parent="Panel/Margin/VBox/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="Fullscreen" type="CheckButton" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Fullscreen"

[node name="Back" type="Button" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[node name="Sample" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3")
bus = &"Effects"

[connection signal="pressed" from="Panel/Margin/VBox/Back" to="." method="close"]
