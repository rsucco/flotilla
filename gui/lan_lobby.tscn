[gd_scene format=3]

[ext_resource type="Script" path="res://gui/lan_lobby.gd" id="1"]
[ext_resource type="StyleBox" path="res://gui/popup.tres" id="2"]

[node name="LANLobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("2")

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "LAN Game"
horizontal_alignment = 1

[node name="Host" type="Button" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
text = "Host a Game"

[node name="HSeparator" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="JoinLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Or join one on this network:"

[node name="Looking" type="Label" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.6)
text = "Looking for games…"

[node name="Games" type="VBoxContainer" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="JoinRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Address" type="LineEdit" parent="Panel/Margin/VBox/JoinRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Host's address, e.g. 192.168.1.20"

[node name="Join" type="Button" parent="Panel/Margin/VBox/JoinRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Join"

[node name="KeyboardHint" type="Label" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.6)
text = "Steam+X opens the keyboard"

[node name="Status" type="Label" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
autowrap_mode = 3

[node name="Back" type="Button" parent="Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[connection signal="pressed" from="Panel/Margin/VBox/Host" to="." method="_on_host_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/JoinRow/Join" to="." method="_on_join_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/Back" to="." method="_on_back_pressed"]
