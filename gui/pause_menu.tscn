[gd_scene format=3]

[ext_resource type="Script" path="res://gui/pause_menu.gd" id="1"]
[ext_resource type="StyleBox" path="res://gui/popup.tres" id="2"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
visible = false
script = ExtResource("1")

[node name="Cover" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0.501961, 0.623529, 1)

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("2")

[node name="Main" type="VBoxContainer" parent="Panel"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Label" type="Label" parent="Panel/Main"]
layout_mode = 2
text = "Paused"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Panel/Main"]
layout_mode = 2
text = "Resume"

[node name="NewGame" type="Button" parent="Panel/Main"]
layout_mode = 2
text = "New Game"

[node name="Replay" type="Button" parent="Panel/Main"]
layout_mode = 2
text = "Replay This Game"

[node name="Title" type="Button" parent="Panel/Main"]
layout_mode = 2
text = "Title Screen"

[node name="Quit" type="Button" parent="Panel/Main"]
layout_mode = 2
text = "Quit Game"

[node name="Confirm" type="VBoxContainer" parent="Panel"]
visible = false
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Label" type="Label" parent="Panel/Confirm"]
layout_mode = 2
text = "Abandon this game?"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Panel/Confirm"]
layout_mode = 2
alignment = 1

[node name="Yes" type="Button" parent="Panel/Confirm/Buttons"]
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
text = "Yes"

[node name="No" type="Button" parent="Panel/Confirm/Buttons"]
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
text = "No"

[connection signal="pressed" from="Panel/Main/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Panel/Main/NewGame" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="Panel/Main/Replay" to="." method="_on_replay_pressed"]
[connection signal="pressed" from="Panel/Main/Title" to="." method="_on_title_pressed"]
[connection signal="pressed" from="Panel/Main/Quit" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="Panel/Confirm/Buttons/Yes" to="." method="_on_yes_pressed"]
[connection signal="pressed" from="Panel/Confirm/Buttons/No" to="." method="_on_no_pressed"]
